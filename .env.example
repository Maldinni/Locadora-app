# Copie este arquivo para .env e ajuste os valores.
# ----------------------------------------------------------------------

# Chave secreta do Django (gere uma nova para produção):
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-esta-chave-em-producao

# Ambiente: define qual módulo de settings usar.
#   locadora.settings.development  (padrão, SQLite, DEBUG=True)
#   locadora.settings.production   (SQLite por padrão, DEBUG=False, segurança)
DJANGO_SETTINGS_MODULE=locadora.settings.development

# Hosts permitidos (separados por vírgula) — em produção, o IP e/ou o domínio.
ALLOWED_HOSTS=localhost,127.0.0.1

# ----------------------------------------------------------------------
# Produção (VPS)
# ----------------------------------------------------------------------
# HTTPS: deixe 0 ao acessar por IP (HTTP). Mude para 1 só quando tiver
# domínio + certificado (Let's Encrypt). Com 1 e sem HTTPS o site fica inacessível.
ENABLE_HTTPS=0

# Banco em produção: "sqlite" (padrão, recomendado p/ VPS pequeno) ou "postgres".
DB_ENGINE=sqlite

# ----------------------------------------------------------------------
# Banco de dados (apenas se DB_ENGINE=postgres)
# ----------------------------------------------------------------------
POSTGRES_DB=locadora
POSTGRES_USER=locadora
POSTGRES_PASSWORD=senha-segura
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ----------------------------------------------------------------------
# Regras de negócio configuráveis
# ----------------------------------------------------------------------
# Multa por dia de atraso na devolução (R$).
MULTA_DIARIA_ATRASO=150.00
